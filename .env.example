# Copy to .env (git-ignored, next to docker-compose.yml) and fill in; docker compose reads it automatically.
# Every value is optional for local dev (empty = dev default). See README.md section 3.

# --- Must change for any shared or public deployment ---
# Signs and verifies access tokens (api-gateway + auth-identity). Generate: openssl rand -hex 32
JWT_SECRET=
# Seeded admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Datastore passwords: URL-safe characters only. Applied when the data volume is first created.
POSTGRES_PASSWORD=
MONGO_PASSWORD=
MINIO_PASSWORD=
CLICKHOUSE_PASSWORD=

# --- Payments ---
# Razorpay test-mode credentials from https://dashboard.razorpay.com/app/keys (test mode).
# Without them, payment endpoints answer 503 PAYMENTS_NOT_CONFIGURED; everything else works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard
# (point it at <public-url>/api/v1/payments/webhook, events: payment.captured, payment.failed).
RAZORPAY_WEBHOOK_SECRET=

# --- Provenance chain ---
# Defaults target the local anvil container; for Amoy set
# CHAIN_RPC_URL=https://rpc-amoy.polygon.technology, a funded RELAYER_KEY, and the deployed CONTRACT_ADDRESS.
CHAIN_RPC_URL=
RELAYER_KEY=
CONTRACT_ADDRESS=

# --- Other ---
# Public origin printed into QR codes, e.g. https://provenance.example.com (default http://localhost:3000).
PUBLIC_BASE_URL=
# Counterfeit-match cut-off 0-1 (default: placeholder 0.9 until calibrated).
MATCH_THRESHOLD=
# Gateway requests per IP per minute (default 300).
RATE_LIMIT_PER_MINUTE=
