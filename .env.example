# Copy to .env (git-ignored) and fill in; docker compose reads it automatically.
# Razorpay test-mode credentials from https://dashboard.razorpay.com/app/keys (test mode).
# Without them, payment endpoints answer 503 PAYMENTS_NOT_CONFIGURED; everything else works.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard
# (point it at <public-url>/api/v1/payments/webhook, events: payment.captured, payment.failed).
RAZORPAY_WEBHOOK_SECRET=
